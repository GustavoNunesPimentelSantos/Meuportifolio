
const canvas = document.getElementById("gameCanvas");
const ctx = canvas.getContext("2d");

const coinsText = document.getElementById("coins");
const livesText = document.getElementById("lives");
const message = document.getElementById("message");
const startButton = document.getElementById("startButton");

const WIDTH = canvas.width;
const HEIGHT = canvas.height;
const WORLD_WIDTH = 3000;
const gravity = 0.65;

let keys = {};
let cameraX = 0;
let score = 0;
let lives = 3;
let running = false;
let gameEnded = false;
let animationId = null;
let lastTime = 0;

const mario = {
    x: 60,
    y: 300,
    w: 30,
    h: 40,
    vx: 0,
    vy: 0,
    speed: 4,
    jumpPower: -13,
    onGround: false,
    invincible: 0,
    direction: 1
};

const platforms = [
    { x: 0, y: 410, w: 700, h: 40 },
    { x: 780, y: 410, w: 500, h: 40 },
    { x: 1360, y: 410, w: 520, h: 40 },
    { x: 1960, y: 410, w: 1040, h: 40 },

    { x: 220, y: 320, w: 120, h: 18 },
    { x: 430, y: 260, w: 120, h: 18 },
    { x: 600, y: 330, w: 100, h: 18 },
    { x: 900, y: 320, w: 140, h: 18 },
    { x: 1120, y: 250, w: 120, h: 18 },
    { x: 1450, y: 320, w: 120, h: 18 },
    { x: 1650, y: 260, w: 120, h: 18 },
    { x: 2020, y: 320, w: 120, h: 18 },
    { x: 2240, y: 260, w: 140, h: 18 },
    { x: 2500, y: 320, w: 130, h: 18 }
];

const coinPositions = [
    [250, 280], [300, 280], [460, 220], [510, 220],
    [630, 290], [850, 370], [930, 280], [980, 280],
    [1150, 210], [1200, 210], [1400, 370],
    [1480, 280], [1690, 220], [1740, 220],
    [1830, 370], [2050, 280], [2280, 220],
    [2330, 220], [2550, 280], [2700, 370]
];

let coins = [];
let enemies = [];
let flag = { x: 2860, y: 300, w: 20, h: 110 };

function createObjects() {
    coins = coinPositions.map(([x, y]) => ({
        x, y, collected: false, radius: 10
    }));

    enemies = [
        { x: 500, y: 382, w: 28, h: 28, vx: 1.3, min: 400, max: 680, alive: true },
        { x: 950, y: 382, w: 28, h: 28, vx: 1.5, min: 800, max: 1200, alive: true },
        { x: 1500, y: 292, w: 28, h: 28, vx: 1.2, min: 1450, max: 1550, alive: true },
        { x: 2100, y: 382, w: 28, h: 28, vx: 1.7, min: 2000, max: 2400, alive: true },
        { x: 2600, y: 382, w: 28, h: 28, vx: 1.4, min: 2500, max: 2800, alive: true }
    ];
}

function resetGame() {
    mario.x = 60;
    mario.y = 300;
    mario.vx = 0;
    mario.vy = 0;
    mario.onGround = false;
    mario.invincible = 0;
    mario.direction = 1;

    cameraX = 0;
    score = 0;
    lives = 3;
    gameEnded = false;

    createObjects();
    updateHUD();
}

function updateHUD() {
    coinsText.textContent = score;
    livesText.textContent = lives;
}

function showMessage(title, text, buttonText) {
    message.innerHTML = `
        <h2>${title}</h2>
        <p>${text}</p>
        <button id="startButton">${buttonText}</button>
    `;

    document.getElementById("startButton").addEventListener("click", startGame);
    message.style.display = "block";
}

function startGame() {
    if (animationId !== null) {
        cancelAnimationFrame(animationId);
    }

    resetGame();
    message.style.display = "none";
    running = true;
    lastTime = 0;
    animationId = requestAnimationFrame(gameLoop);
}

function rectsCollide(a, b) {
    return (
        a.x < b.x + b.w &&
        a.x + a.w > b.x &&
        a.y < b.y + b.h &&
        a.y + a.h > b.y
    );
}

function update(dt) {
    if (!running) return;

    const step = Math.min(dt / 16.67, 2);

    // Movimento horizontal
    mario.vx = 0;

    if (keys.ArrowRight || keys.KeyD) {
        mario.vx = mario.speed;
        mario.direction = 1;
    }

    if (keys.ArrowLeft || keys.KeyA) {
        mario.vx = -mario.speed;
        mario.direction = -1;
    }

    mario.x += mario.vx * step;
    mario.x = Math.max(0, Math.min(WORLD_WIDTH - mario.w, mario.x));

    // Gravidade e pulo
    mario.vy += gravity * step;
    mario.y += mario.vy * step;
    mario.onGround = false;

    // Colisão com plataformas ao cair
    for (const p of platforms) {
        const horizontalOverlap =
            mario.x + mario.w > p.x &&
            mario.x < p.x + p.w;

        const crossedPlatform =
            mario.y + mario.h >= p.y &&
            mario.y + mario.h - mario.vy * step <= p.y + 4;

        if (
            horizontalOverlap &&
            crossedPlatform &&
            mario.vy >= 0 &&
            mario.y + mario.h <= p.y + p.h
        ) {
            mario.y = p.y - mario.h;
            mario.vy = 0;
            mario.onGround = true;
        }
    }

    // Moedas
    for (const coin of coins) {
        if (coin.collected) continue;

        const coinBox = {
            x: coin.x - coin.radius,
            y: coin.y - coin.radius,
            w: coin.radius * 2,
            h: coin.radius * 2
        };

        if (rectsCollide(mario, coinBox)) {
            coin.collected = true;
            score++;
            updateHUD();
        }
    }

    // Inimigos
    for (const enemy of enemies) {
        if (!enemy.alive) continue;

        enemy.x += enemy.vx * step;

        if (enemy.x <= enemy.min || enemy.x + enemy.w >= enemy.max) {
            enemy.vx *= -1;
        }

        if (rectsCollide(mario, enemy)) {
            const marioWasAbove =
                mario.vy > 0 &&
                mario.y + mario.h - mario.vy * step <= enemy.y + 8;

            if (marioWasAbove) {
                enemy.alive = false;
                mario.vy = -9;
            } else if (mario.invincible <= 0) {
                lives--;
                mario.invincible = 90;
                mario.vy = -7;
                mario.vx = mario.x < enemy.x ? -5 : 5;
                updateHUD();

                if (lives <= 0) {
                    endGame(false);
                    return;
                }
            }
        }
    }

    if (mario.invincible > 0) {
        mario.invincible -= step;
    }

    // Cair fora do cenário
    if (mario.y > HEIGHT + 100) {
        lives--;
        updateHUD();

        if (lives <= 0) {
            endGame(false);
            return;
        }

        mario.x = Math.max(60, cameraX + 50);
        mario.y = 250;
        mario.vx = 0;
        mario.vy = 0;
        mario.invincible = 90;
    }

    // Câmera acompanha Mario
    cameraX = Math.max(
        0,
        Math.min(WORLD_WIDTH - WIDTH, mario.x - WIDTH * 0.35)
    );

    // Chegada à bandeira
    if (rectsCollide(mario, flag)) {
        endGame(true);
    }
}

function drawBackground() {
    const sky = ctx.createLinearGradient(0, 0, 0, HEIGHT);
    sky.addColorStop(0, "#65c7ff");
    sky.addColorStop(1, "#d6f5ff");

    ctx.fillStyle = sky;
    ctx.fillRect(0, 0, WIDTH, HEIGHT);

    // Sol
    ctx.fillStyle = "#ffdf55";
    ctx.beginPath();
    ctx.arc(760, 70, 35, 0, Math.PI * 2);
    ctx.fill();

    // Nuvens
    for (let i = 0; i < 7; i++) {
        const x = ((i * 190 - cameraX * 0.25) % 1100 + 1100) % 1100;

        ctx.fillStyle = "rgba(255,255,255,0.9)";
        ctx.beginPath();
        ctx.arc(x, 80 + (i % 3) * 35, 22, 0, Math.PI * 2);
        ctx.arc(x + 25, 70 + (i % 3) * 35, 28, 0, Math.PI * 2);
        ctx.arc(x + 53, 82 + (i % 3) * 35, 20, 0, Math.PI * 2);
        ctx.fill();
    }

    // Montanhas
    for (let i = 0; i < 8; i++) {
        const x = i * 180 - (cameraX * 0.45) % 180;

        ctx.fillStyle = "#75d68a";
        ctx.beginPath();
        ctx.moveTo(x - 70, 410);
        ctx.lineTo(x + 60, 220);
        ctx.lineTo(x + 190, 410);
        ctx.fill();
    }
}

function drawPlatforms() {
    for (const p of platforms) {
        const x = p.x - cameraX;

        if (x + p.w < 0 || x > WIDTH) continue;

        ctx.fillStyle = "#a75a2a";
        ctx.fillRect(x, p.y, p.w, p.h);

        ctx.fillStyle = "#35b84a";
        ctx.fillRect(x, p.y, p.w, 8);

        ctx.fillStyle = "#d88b45";

        for (let bx = x; bx < x + p.w; bx += 30) {
            ctx.fillRect(bx, p.y + 13, 25, 3);
        }
    }
}
function drawMario() {
    const x = mario.x - cameraX;
    const y = mario.y;

    // Pisca enquanto está invencível
    if (mario.invincible > 0 && Math.floor(mario.invincible / 6) % 2 === 0) {
        return;
    }

    ctx.save();

    // Boné
    ctx.fillStyle = "#e52521";
    ctx.fillRect(x + 3, y, 25, 8);
    ctx.fillRect(x, y + 7, 30, 6);

    // Rosto
    ctx.fillStyle = "#ffbd80";
    ctx.fillRect(x + 5, y + 12, 20, 12);

    // Cabelo e bigode
    ctx.fillStyle = "#713b18";
    ctx.fillRect(x + 3, y + 12, 5, 10);
    ctx.fillRect(x + 11, y + 21, 14, 5);

    // Olho
    ctx.fillStyle = "#202020";
    ctx.fillRect(mario.direction === 1 ? x + 20 : x + 8, y + 14, 3, 4);

    // Camisa
    ctx.fillStyle = "#e52521";
    ctx.fillRect(x + 4, y + 25, 22, 7);

    // Macacão
    ctx.fillStyle = "#1769d2";
    ctx.fillRect(x + 4, y + 30, 22, 8);
    ctx.fillRect(x + 6, y + 25, 5, 9);
    ctx.fillRect(x + 19, y + 25, 5, 9);

    // Botões
    ctx.fillStyle = "#ffdf00";
    ctx.fillRect(x + 10, y + 29, 3, 3);
    ctx.fillRect(x + 20, y + 29, 3, 3);

    // Sapatos
    ctx.fillStyle = "#603813";
    ctx.fillRect(x + 1, y + 37, 12, 3);
    ctx.fillRect(x + 18, y + 37, 12, 3);

    ctx.restore();
}

function drawCoins() {
    for (const coin of coins) {
        if (coin.collected) continue;

        const x = coin.x - cameraX;
        const y = coin.y;

        if (x < -20 || x > WIDTH + 20) continue;

        ctx.fillStyle = "#ffdf00";
        ctx.beginPath();
        ctx.ellipse(
            x, y, 9, 12,
            0, 0, Math.PI * 2
        );
        ctx.fill();

        ctx.strokeStyle = "#e69b00";
        ctx.lineWidth = 3;
        ctx.stroke();

        ctx.fillStyle = "#fff2a8";
        ctx.fillRect(x - 2, y - 7, 3, 14);
    }
}

function drawEnemies() {
    for (const enemy of enemies) {
        if (!enemy.alive) continue;

        const x = enemy.x - cameraX;
        const y = enemy.y;

        ctx.fillStyle = "#a65a27";
        ctx.beginPath();
        ctx.ellipse(
            x + enemy.w / 2,
            y + 17,
            enemy.w / 2,
            12,
            0, Math.PI, Math.PI * 2
        );
        ctx.fill();

        ctx.fillStyle = "#f4d2a3";
        ctx.fillRect(x + 3, y + 12, enemy.w - 6, 12);

        ctx.fillStyle = "#fff";
        ctx.fillRect(x + 6, y + 9, 6, 7);
        ctx.fillRect(x + 17, y + 9, 6, 7);

        ctx.fillStyle = "#222";
        ctx.fillRect(x + 8, y + 12, 3, 4);
        ctx.fillRect(x + 19, y + 12, 3, 4);
    }
}

function drawFlag() {
    const x = flag.x - cameraX;

    ctx.fillStyle = "#eeeeee";
    ctx.fillRect(x, flag.y, 7, flag.h);

    ctx.fillStyle = "#e63946";
    ctx.beginPath();
    ctx.moveTo(x + 7, flag.y);
    ctx.lineTo(x + 52, flag.y + 18);
    ctx.lineTo(x + 7, flag.y + 36);
    ctx.closePath();
    ctx.fill();

    ctx.fillStyle = "#ffdf00";
    ctx.fillRect(x - 8, flag.y + flag.h, 23, 10);
}

function draw() {
    drawBackground();
    drawPlatforms();
    drawCoins();
    drawEnemies();
    drawFlag();
    drawMario();
}

function gameLoop(timestamp) {
    if (!running) return;

    const dt = lastTime ? timestamp - lastTime : 16.67;
    lastTime = timestamp;

    update(dt);
    draw();

    if (running) {
        animationId = requestAnimationFrame(gameLoop);
    }
}

function endGame(won) {
    running = false;
    gameEnded = true;

    if (animationId !== null) {
        cancelAnimationFrame(animationId);
        animationId = null;
    }

    if (won) {
        showMessage(
            "🏆 VOCÊ VENCEU!",
            `Parabéns! Você coletou ${score} moedas e chegou à bandeira!`,
            "JOGAR NOVAMENTE"
        );
    } else {
        showMessage(
            "💔 FIM DE JOGO",
            `Você coletou ${score} moedas. Tente novamente!`,
            "TENTAR NOVAMENTE"
        );
    }
}

// Teclado
document.addEventListener("keydown", (event) => {
    if ([
        "ArrowLeft", "ArrowRight", "ArrowUp",
        "Space", "KeyA", "KeyD", "KeyW"
    ].includes(event.code)) {
        event.preventDefault();
    }

    keys[event.code] = true;

    if (
        running &&
        (event.code === "Space" ||
         event.code === "ArrowUp" ||
         event.code === "KeyW") &&
        mario.onGround
    ) {
        mario.vy = mario.jumpPower;
        mario.onGround = false;
    }
});

document.addEventListener("keyup", (event) => {
    keys[event.code] = false;
});

// Controles para celular
function setupHoldButton(id, key) {
    const button = document.getElementById(id);

    const press = (event) => {
        event.preventDefault();
        keys[key] = true;
    };

    const release = (event) => {
        event.preventDefault();
        keys[key] = false;
    };

    button.addEventListener("pointerdown", press);
    button.addEventListener("pointerup", release);
    button.addEventListener("pointerleave", release);
    button.addEventListener("pointercancel", release);
}

setupHoldButton("leftButton", "ArrowLeft");
setupHoldButton("rightButton", "ArrowRight");

const jumpButton = document.getElementById("jumpButton");

jumpButton.addEventListener("pointerdown", (event) => {
    event.preventDefault();

    if (running && mario.onGround) {
        mario.vy = mario.jumpPower;
        mario.onGround = false;
    }
});

startButton.addEventListener("click", startGame);

// Desenhar a tela inicial
createObjects();
draw();

